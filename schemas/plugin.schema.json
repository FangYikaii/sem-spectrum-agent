{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semispectra.io/schemas/v1alpha1/plugin.schema.json",
  "title": "SemiSpectra Plugin Manifest",
  "description": "Contract for auditable SEM analysis plugins.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "semispectra.io/v1alpha1"},
    "kind": {"const": "SemPlugin"},
    "metadata": {
      "type": "object",
      "required": ["id", "name", "version", "vendor", "license", "maturity"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"},
        "name": {"type": "string", "minLength": 3, "maxLength": 120},
        "version": {"type": "string", "pattern": "^v?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"},
        "vendor": {"type": "string", "minLength": 2, "maxLength": 120},
        "license": {"type": "string", "minLength": 2, "maxLength": 80},
        "maturity": {"enum": ["experimental", "beta", "production", "deprecated"]}
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["type", "runtime", "capabilities", "contracts", "permissions", "quality", "provenance"],
      "properties": {
        "type": {"enum": ["ingest", "analysis", "knowledge", "policy", "ui", "instrument"]},
        "runtime": {
          "type": "object",
          "required": ["kind", "image", "entrypoint"],
          "properties": {
            "kind": {"enum": ["oci", "python-wheel", "wasm"]},
            "image": {"type": "string", "minLength": 5},
            "entrypoint": {"type": "string", "minLength": 3}
          },
          "additionalProperties": false
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "mcp": {
              "type": "object",
              "properties": {
                "tools": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_-]*$"}, "uniqueItems": true},
                "resources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
              },
              "additionalProperties": false
            },
            "ui": {
              "type": "object",
              "properties": {
                "panels": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "uniqueItems": true}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "contracts": {
          "type": "object",
          "required": ["inputs", "outputs"],
          "properties": {
            "inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
            "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "permissions": {
          "type": "object",
          "required": ["data", "network", "compute"],
          "properties": {
            "data": {
              "type": "object",
              "required": ["read", "write"],
              "properties": {
                "read": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                "write": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
              },
              "additionalProperties": false
            },
            "network": {
              "type": "object",
              "required": ["egress"],
              "properties": {
                "egress": {"oneOf": [{"const": "none"}, {"type": "array", "items": {"type": "string", "format": "uri"}, "uniqueItems": true}]}
              },
              "additionalProperties": false
            },
            "compute": {
              "type": "object",
              "required": ["gpu"],
              "properties": {"gpu": {"type": "boolean"}},
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "quality": {
          "type": "object",
          "required": ["requiresCalibration", "emitsUncertainty", "testDataset"],
          "properties": {
            "requiresCalibration": {"type": "boolean"},
            "emitsUncertainty": {"type": "boolean"},
            "testDataset": {"type": "string", "pattern": "^semispectra://"}
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "required": ["sbom", "signature"],
          "properties": {
            "sbom": {"type": "string", "minLength": 3},
            "signature": {"type": "string", "minLength": 3}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
